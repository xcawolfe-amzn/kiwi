<?xml version="1.0" encoding="utf-8"?>

<!-- The line below is required in order to use the multibuild OBS features -->
<!-- OBS-Profiles: @BUILD_FLAVOR@ -->

<image schemaversion="7.5" name="amzn2023-kiwi-test-image-live-disk">
<description type="system">
<author>Caleb Wolfe</author>
<contact>xcawolfe@amazon.com</contact>
<specification>Amazon Appliance</specification>
</description>
<profiles>
        <profile name="ami" description="Live image of Amazon"/>
        <profile name="onprem" description="OnPrem of Amazon"/>
</profiles>
<preferences>
<version>2.0.0</version>
<packagemanager>dnf4</packagemanager>
<locale>en_US</locale>
<keytable>us</keytable>
<timezone>UTC</timezone>
<rpm-check-signatures>false</rpm-check-signatures>
</preferences>
<!-- <preferences profiles="Live"> -->
<!--     <type image="iso" flags="overlay" firmware="uefi" hybridpersistent_filesystem="ext4" hybridpersistent="true" kernelcmdline="console=ttyS0"> -->
<!--         <bootloader name="grub2" console="serial" timeout="10"/> -->
<!--     </type> -->
<!-- </preferences> -->
<preferences>
        <type image="oem"  filesystem="xfs" kernelcmdline="console=ttyS0" firmware="efi" format="qcow2"  rootfs_label="amzn2023" >
        <systemdisk name="amzn2023">
                <volume name="@root=root"/>
                <volume name="home" parent="/"/>
                <volume name="var" parent="/"/>
        </systemdisk>
        <oemconfig>
                <oem-resize>false</oem-resize>
        </oemconfig>
        <bootloader name="grub2" console="serial" timeout="10"/>
        </type>
</preferences>
<users>
        <user password="$1$wYJUgpM5$RXMMeASDc035eX.NbYWFl0" home="/root" name="root" groups="root"/>
</users>
<repository priority="2" repository_gpgcheck="false" sourcetype="mirrorlist" >
        <source path="https://cdn.amazonlinux.com/al2023/core/mirrors/latest/x86_64/mirror.list"/>
</repository>

<repository priority="1" repository_gpgcheck="false" sourcetype="baseurl" >
<source path="file:///rpms"/>
</repository>

<packages type="image" profile="ami">
        <namedCollection name="ami"/>
        <package name="tar"/>
        <package name="awscli"/>
        <package name="sssd-common"/>
        <package name="sssd-kcm"/>
        <package name="grub2-pc-modules"/>
        <package name="zram-generator"/>
        <package name="zram-generator-defaults"/>
        <package name="systemd-resolved"/>
        <package name="amazon-chrony-config"/>
        <package name="initscripts"/>
</packages>

<!-- on prem -->
<packages type="bootstrap" profile="onprem">
        <package name="grub2-pc-modules"/>
        <package name="grub2-pc"/>
</packages>
<packages type="image" profile="onprem">
        <namedCollection name="onprem-minimal"/>
        <namedCollection name="onprem"/>
        <package name="kernel-modules-extra"/>
        <package name="zstd"/>
        <package name="systemd-networkd"/>
         <!-- dont install --> 
        <ignore name="vim-minimal"/>
        <ignore name="curl-minimal"/>
        <ignore name="libcurl-minimal"/>
        <ignore name="gnupg2-minimal"/>
         <!-- dont install --> 
<packages/>
<!-- on prem -->

<!-- global for all images -->
<packages type="image">
        <package name="system-release"/>
        <namedCollection name="core"/>
        <package name="kernel"/>
        <!-- dont install --> 
        <ignore name="firewalld"/>
        <ignore name="amazon-linux-repo-s3"/>
        <!-- dont install --> 
        <package name="grub2"/>
        <package name="grub2-pc"/>
        <package name="grub2-efi-x64-modules"/>
        <package name="grub2-emu-modules"/>
        <package name="grub2-emu"/>
        <package name="tar"/>
        <package name="tzdata"/>
</packages>
<packages type="bootstrap">
        <package name="system-release"/>
        <namedCollection name="core"/>
        <package name="grub2-efi-x64-ec2"/>
        <package name="grub2-efi-x64-modules"/>
        <ignore name="firewalld"/>
        <!-- <package name="system-release"/> -->
</packages>
<!-- global for all images -->

</image>
